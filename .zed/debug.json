[
    {
        "adapter": "Debugpy",
        "label": "run module '…ps/api/views.py'",
        "request": "launch",
        "python": "$ZED_CUSTOM_PYTHON_ACTIVE_ZED_TOOLCHAIN",
        "args": [],
        "cwd": "$ZED_WORKTREE_ROOT",
        "module": "$ZED_CUSTOM_PYTHON_MODULE_NAME"
    },
    {
        "label": "Django debug",
        "adapter": "Debugpy",
        "request": "launch",
        "python": "$ZED_CUSTOM_PYTHON_ACTIVE_ZED_TOOLCHAIN",
        "cwd": "$ZED_WORKTREE_ROOT",
        "program": "${workspaceFolder}/src/manage.py",
        "args": ["runserver", "0.0.0.0:8000"]
    }
]
